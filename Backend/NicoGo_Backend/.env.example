APP_NAME=NicoGo API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQL Server principal. Do not commit real credentials.
DATABASE_URL=mssql+pyodbc://sa:YOUR_PASSWORD@192.168.80.23/NicoGo_Data_Base?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Origins separated by commas.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
